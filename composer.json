{
    "name": "haikiri/messenger-routing",
    "description": "MessengerRouting – is a Command Router for messengers, like Telegram and Others. Php8 command handler attributes.",
    "keywords": [
        "php",
        "php8",
        "sdk",
        "bot",
        "routing",
        "messenger",
        "handler",
        "handlers",
        "attributes"
    ],
    "homepage": "https://github.com/MKC-MKC/MessengerRouter",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Haikiri\\MessengerRouting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\MessengerRouting\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.0",
        "ext-mbstring": "*"
    },
    "authors": [
        {
            "name": "Haikiri",
            "email": "haikiri@ya.ru",
            "homepage": "https://haikiri.t.me"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "conflict": {
        "doctrine/instantiator": ">=2.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit --colors=always tests"
    }
}
